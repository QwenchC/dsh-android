   clip: rect(0 0 0 0);
   white-space: nowrap;
 }
+
+
+/* Android/phone widths need the options column's full width. Keep section
+   navigation in a horizontal rail instead of squeezing controls beside it. */
+@media (max-width: 600px) {
+  .panel {
+    flex-direction: column;
+    width: calc(100vw - 24px);
+    max-width: calc(100vw - 24px);
+    height: min(800px, calc(100dvh - 24px));
+    border-radius: 20px;
+  }
+
+  .nav {
+    width: 100%;
+    padding: 16px 16px 0;
+    gap: 12px;
+  }
+
+  .navTitle {
+    padding: 0 44px 0 0;
+  }
+
+  .navList {
+    flex-direction: row;
+    overflow-x: auto;
+    padding-bottom: 4px;
+  }
+
+  .navCell {
+    flex: none;
+  }
+
+  .content {
+    min-height: 0;
+  }
+
+  .header {
+    height: auto;
+    padding: 8px 16px;
+  }
+
+  .actions {
+    margin-left: 0;
+    justify-content: flex-start;
+    flex-wrap: wrap;
+  }
+
+  .close {
+    position: absolute;
+    top: 12px;
+    right: 12px;
+    width: 32px;
+    height: 32px;
+    flex: none;
+  }
+
+  .options {
+    padding: 8px 16px 16px;
+  }
+}
